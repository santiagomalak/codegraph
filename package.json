{
  "name": "code-graph-unified",
  "version": "3.0.0",
  "description": "Analiza un proyecto y lo convierte en un grafo de conocimiento multicapa, para vos y para la IA.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @codegraph/core && npm run build -w @codegraph/cli && npm run build -w @codegraph/web",
    "dev:web": "npm run dev -w @codegraph/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "analyze": "node packages/cli/dist/index.js analyze",
    "serve": "node packages/cli/dist/index.js serve",
    "legacy:dev": "vite",
    "legacy:build": "tsc && vite build"
  },
  "keywords": [
    "code-analysis",
    "ast",
    "knowledge-graph",
    "codemap",
    "visualization",
    "tree-sitter"
  ],
  "author": "Santiago Malak",
  "license": "MIT",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "autoprefixer": "^10.4.17",
    "comlink": "^4.4.1",
    "d3": "^7.9.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "happy-dom": "^20.10.6",
    "husky": "^9.0.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "semantic-release": "^25.0.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-comlink": "^4.1.0",
    "vitest": "^1.6.0"
  }
}
