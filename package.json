{
  "name": "code-graph-unified",
  "version": "2.0.0",
  "description": "Analizador de proyectos con visualización de grafo interactivo y generación de CODEMAP - TypeScript + Tailwind + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:vercel": "tsc && vite build --config vite.config.vercel.ts",
    "build:action": "node scripts/build-action.js",
    "preview": "vite preview",
    "lint": "eslint src --ext js,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,json,css,md}\"",
    "prepare": "husky install",
    "release": "semantic-release"
  },
  "keywords": [
    "code-analysis",
    "ast",
    "graph",
    "codemap",
    "visualization",
    "typescript",
    "tailwind"
  ],
  "author": "Santiago Malak",
  "license": "MIT",
  "dependencies": {
    "comlink": "^4.4.1",
    "commander": "^12.0.0",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "autoprefixer": "^10.4.17",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "happy-dom": "^20.10.6",
    "husky": "^9.0.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "semantic-release": "^25.0.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-comlink": "^4.1.0",
    "vitest": "^1.3.0"
  }
}
